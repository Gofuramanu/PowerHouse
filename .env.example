# ============================================================================
# CONTOH VARIABEL LINGKUNGAN PROYEK (TANPA KREDENSIAL ASLI)
# Salin file ini menjadi ".env" atau gunakan nilainya di config.h & Vercel.
# ============================================================================

# --- SUPABASE BACKEND ---
SUPABASE_URL=https://PROJECT_ID_ANDA.supabase.co
SUPABASE_ANON_KEY=MASUKKAN_SUPABASE_ANON_PUBLIC_KEY_ANDA
# Catatan: JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di kode frontend atau ESP32!

# --- IDENTITAS PERANGKAT ESP32 ---
DEVICE_ID=panel-utama-01
DEVICE_SECRET_KEY=GANTI_KUNCI_RAHASIA_ESP32_ANDA

# --- WIFI PANEL LISTRIK ---
WIFI_SSID=NAMA_WIFI_LOKASI_PANEL
WIFI_PASSWORD=PASSWORD_WIFI_LOKASI_PANEL

# --- OPSIONAL: FIREBASE LEGACY AUDIT ---
FIREBASE_API_KEY=MASUKKAN_FIREBASE_WEB_API_KEY
FIREBASE_DATABASE_URL=https://PROJECT_ID_ANDA-default-rtdb.firebaseio.com/
